# OpenAI API Key
OPENAI_API_KEY=
DATABASE_URL="postgresql://user:password@localhost:5432/finance_db?schema=public"

# Docker specific (used by docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=finance_db
# Public domain for Caddy/HTTPS (must point to the server). Use "localhost" for a local run.
DOMAIN=fin.example.com
# Set to "caddy" to run the bundled Caddy (needs free ports 80/443).
# Leave empty if another reverse proxy on the host forwards to 127.0.0.1:APP_PORT.
COMPOSE_PROFILES=caddy
# Host port the app is published on (localhost only)
APP_PORT=3000

# Required
JWT_SECRET=
EXCHANGERATE_API_KEY=
NODE_ENV="development"
# HTTP port (default 5000; Docker uses 3000)
PORT=5000
DEEPSEEK_API_KEY=

# Required. Encryption key for password recovery (exactly 32 characters for AES-256),
# e.g. `openssl rand -hex 16`
ENCRYPTION_KEY=

# SMTP Configuration for sending emails
# Note: For Gmail, use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Finance App <your-email@gmail.com>"

# Sign-in through Google / Mail.ru / VK (optional; a button appears only when its keys are set).
# Public address of the app; redirect URIs are PUBLIC_URL + /api/auth/oauth/<provider>/callback.
# In Docker it defaults to https://DOMAIN, so set it only outside Docker or for a different address.
# PUBLIC_URL=https://fin.example.com
# Google: https://console.cloud.google.com/apis/credentials → OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mail.ru: https://o2.mail.ru/app/
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
# VK ID: https://id.vk.com/about/business/go → app of type "Web" (only the app ID is needed)
VK_CLIENT_ID=
